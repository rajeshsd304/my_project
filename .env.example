DATABASE_URL="file:./dev.db"
# Generate with: openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-string"

# Optional
# STORAGE_DIR="storage"                 # where uploaded images / note PDFs are kept
# NEXT_PUBLIC_TIMEZONE="Asia/Dhaka"     # timezone for dates shown in the app and PDFs
# PUPPETEER_EXECUTABLE_PATH=""          # use a system Chrome/Chromium for PDFs instead of Puppeteer's
# SEED_DEMO="false"                     # skip demo content when seeding
# INSECURE_COOKIES="true"               # only to test a production build over plain HTTP
